{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Save My Eyes",
  "version": "0.3.0",
  "identifier": "com.ammadeo.savemyeyes",
  "build": {
    "beforeDevCommand": "deno task dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "deno task build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/AppIcon.icon",
      "icons/icon.ico"
    ],
    "copyright": "Copyright © 2020-2026 Ammadeo",
    "category": "Healthcare and Fitness",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
